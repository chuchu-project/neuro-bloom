# 书生大模型（OpenAI 兼容）
# 书生 InternLM 平台实测地址：https://chat.intern-ai.org.cn/api/v1
# 可用模型：intern-s1-mini(快~5s) / intern-s1-pro / intern-s2-preview-397b(赛题点名,慢~40s)
SHUSHENG_API_KEY=your_key_here
SHUSHENG_BASE_URL=https://chat.intern-ai.org.cn/api/v1
SHUSHENG_MODEL=intern-s1-mini

# 大模型调用节流（秒）：状态不变时不必每次都调
LLM_MIN_INTERVAL=8
LLM_TIMEOUT=60

# 可选：Hermes Agent（若用作主 harness）
HERMES_MODEL_PROVIDER=custom
HERMES_BASE_URL=${SHUSHENG_BASE_URL}
HERMES_API_KEY=${SHUSHENG_API_KEY}

# 服务地址
EEG_WS_URL=ws://127.0.0.1:8765/ws/eeg
WORLD_WS_URL=ws://127.0.0.1:8765/ws/world

# 数据层
POSTGRES_DSN=postgresql://neuro:neuro@127.0.0.1:5432/neurobloom
REDIS_URL=redis://127.0.0.1:6379/0
CHROMA_DIR=./.data/chroma

# 演示模式：合成板时让状态缓慢循环（relaxed→focused→anxious），世界可见地变化
DEMO_MODE=1
DEMO_CYCLE=60
